# ============================================================
# 부산 내집마련 대시보드 — 환경변수 예시
# 이 파일을 복사해서 .env로 만든 뒤 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# ===== 공공 API (data.go.kr에서 발급) =====
MOLIT_API_KEY=           # 국토부 실거래가 API
APPLYHOME_API_KEY=       # 청약홈 오픈API
LH_API_KEY=              # LH 청약센터 API

# ===== 네이버 검색 API (developers.naver.com) =====
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== Anthropic Claude API (console.anthropic.com) =====
ANTHROPIC_API_KEY=       # sk-ant-...

# ===== 카카오 나에게 보내기 (developers.kakao.com) =====
KAKAO_ACCESS_TOKEN=

# ===== Gmail SMTP =====
GMAIL_USER=              # yourname@gmail.com
GMAIL_APP_PASSWORD=      # Google 계정 → 앱 비밀번호 (16자리)

# ===== 데이터베이스 =====
DATABASE_URL=sqlite+aiosqlite:///./dashboard.db
# 프로덕션 권장: postgresql+asyncpg://user:password@host:5432/dbname

# ===== 앱 설정 =====
TZ=Asia/Seoul
USE_MOCK=true            # true: 목업 데이터 / false: 실제 API 사용

# ===== 보안 =====
# 강력한 토큰 생성: openssl rand -hex 32
ADMIN_TOKEN=change-me-use-openssl-rand-hex-32

# 배포 도메인 (콤마로 여러 개 가능)
# 예: https://buyhouse-production.up.railway.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
