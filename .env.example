# 공공 API
MOLIT_API_KEY=           # 국토부 실거래가 API (data.go.kr)
APPLYHOME_API_KEY=       # 청약홈 API (data.go.kr)
LH_API_KEY=              # LH청약센터 API (data.go.kr)

# 네이버 API (developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI (console.anthropic.com)
ANTHROPIC_API_KEY=

# 카카오 (developers.kakao.com)
KAKAO_ACCESS_TOKEN=

# 이메일
GMAIL_USER=              # Gmail 주소
GMAIL_APP_PASSWORD=      # Gmail 앱 비밀번호 (2단계 인증 후 발급)

# DB
DATABASE_URL=sqlite+aiosqlite:///./dashboard.db

# 앱 설정
TZ=Asia/Seoul
USE_MOCK=true            # API 키 없을 때 목업 데이터 사용

# 보안
ADMIN_TOKEN=             # openssl rand -hex 32 로 생성
ALLOWED_ORIGINS=http://localhost:5173  # 배포 시 실제 도메인으로 변경
